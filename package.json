{
    "name": "eld-platform",
    "private": true,
    "version": "0.0.0",
    "packageManager": "pnpm@9.12.0",
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=9.0.0"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
        "clean": "turbo run clean && rimraf node_modules"
    },
    "devDependencies": {
        "@types/node": "^22.7.0",
        "prettier": "^3.3.3",
        "rimraf": "^6.0.1",
        "turbo": "^2.1.3",
        "typescript": "^5.6.0"
    }
}
