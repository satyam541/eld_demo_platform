# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` (gitignored) and fill in real values.
# Do NOT commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://eld:eld_dev@localhost:5432/eld
REDIS_URL=redis://:dev@localhost:6379

# ── MQTT broker ─────────────────────────────────────────────────────────────
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=fleet_user
MQTT_PASSWORD=change_me

# ── Soketi (Pusher protocol WebSocket) ──────────────────────────────────────
SOKETI_HOST=http://localhost:6001
SOKETI_APP_ID=eld
SOKETI_APP_KEY=dev_key
SOKETI_APP_SECRET=dev_secret

# ── Next.js / Auth.js ───────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# ── Maps ────────────────────────────────────────────────────────────────────
MAPTILER_API_KEY=

# ── Email (Resend or SMTP) ──────────────────────────────────────────────────
RESEND_API_KEY=

# ── Object storage (Cloudflare R2) ──────────────────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eld-platform
R2_ENDPOINT=

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN_PORTAL=
SENTRY_DSN_BRIDGE=
SENTRY_DSN_WORKER=
