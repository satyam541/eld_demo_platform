{
    "name": "ingest-worker",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "lint": "echo 'placeholder' && exit 0",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "replay": "tsx src/replay.ts",
        "clean": "rimraf dist .turbo"
    },
    "dependencies": {
        "@eld/db": "workspace:*",
        "@eld/shared": "workspace:*",
        "dotenv": "^16.4.5",
        "ioredis": "^5.4.1",
        "pino": "^9.4.0",
        "pino-pretty": "^11.2.2",
        "pusher": "^5.2.0"
    },
    "devDependencies": {
        "@types/node": "^22.7.0",
        "rimraf": "^6.0.1",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.1"
    }
}
