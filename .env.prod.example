# Production environment for docker-compose.prod.yml
# Copy to .env on the server and fill in real values.

# --- Postgres / Timescale ---
POSTGRES_USER=eld
POSTGRES_PASSWORD=replace_with_a_long_random_string
POSTGRES_DB=eld

# --- Redis ---
REDIS_PASSWORD=replace_with_a_long_random_string

# --- Soketi (Pusher protocol) ---
SOKETI_APP_ID=eld
SOKETI_APP_KEY=replace_with_random_pubkey
SOKETI_APP_SECRET=replace_with_random_secret

# Hostname clients use to reach Soketi (no scheme, no port — just the host).
# Behind Cloudflare/Caddy: same domain as the portal, port 443.
PUBLIC_SOKETI_HOST=eld.example.com
PUBLIC_SOKETI_PORT=443

# --- Portal / NextAuth ---
NEXTAUTH_SECRET=replace_with_openssl_rand_base64_32
NEXTAUTH_URL=https://eld.example.com

# --- MapTiler (free tier OK for MVP) ---
MAPTILER_API_KEY=

# --- Ingest worker firewall (optional comma-separated CIDRs) ---
# Get the Geometris egress IPs from their NOC and lock down here.
INGEST_ALLOWED_SOURCES=
